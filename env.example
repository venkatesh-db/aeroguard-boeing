# Copy to .env and fill in. Never commit .env.

# Course default: OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=paste-your-key-here
# Optional model overrides
# CHAT_MODEL=gpt-4.1
# CHAT_MODEL_MINI=gpt-4.1-mini
# EMBED_MODEL=text-embedding-3-small

# Offline option (no key, no cloud): a local model through Ollama
# LLM_PROVIDER=ollama
# CHAT_MODEL=llama3
# EMBED_MODEL=llama3

# Backend address used by the Streamlit UI
API_URL=http://localhost:8000

# Day 5: token the MCP server expects from the agent
MCP_ACCESS_TOKEN=change-me-training-token
